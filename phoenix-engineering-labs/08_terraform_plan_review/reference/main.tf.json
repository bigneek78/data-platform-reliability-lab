{
  "terraform": {
    "required_version": ">= 1.6.0, < 2.0.0",
    "required_providers": {"aws": {"source": "hashicorp/aws", "version": ">= 5.0.0, < 7.0.0"}}
  },
  "variable": {"vpc_id": {"type": "string"}},
  "provider": {"aws": {"region": "us-east-1"}},
  "resource": {
    "aws_security_group": {
      "lab_administration": {
        "name": "phoenix-lab-administration",
        "description": "Reviewed lab SSH rule using a documentation-only CIDR",
        "vpc_id": "${var.vpc_id}",
        "ingress": [{"description": "Replace with an approved lab administration range", "from_port": 22, "to_port": 22, "protocol": "tcp", "cidr_blocks": ["192.0.2.0/24"]}],
        "tags": {"Environment": "lab", "Purpose": "demonstration"}
      }
    }
  }
}
